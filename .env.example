SECRET_KEY=change-me-to-a-random-string
DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.local

# Leave DATABASE_URL empty to use SQLite locally; set PostgreSQL for parity.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/shopbazar

# Redis is optional locally. Set USE_REDIS=True once redis-server is running.
REDIS_URL=redis://localhost:6379/0
USE_REDIS=False

ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@shopbazar.test

# Seeds the SiteSettings singleton on first run only.
PLATFORM_FEE_PERCENTAGE=2.5
